[Unit]
Description=YSF to BrandMeister DG-ID Router Admin UI
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/ysf-bm-router
Environment=PYTHONPATH=/opt/ysf-bm-router/src
ExecStart=/usr/bin/python3 -m ysf_bm_router.admin --config /opt/ysf-bm-router/config/ysf-bm-router.toml --host 0.0.0.0 --port 8092 --log-level INFO
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
